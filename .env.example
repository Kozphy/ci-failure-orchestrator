# Copy to .env (git-ignored) and fill in. Never commit real values.
POSTGRES_USER=orchestrator
# Use URL-safe characters (letters, digits, - _ .): it is embedded in the database URL.
POSTGRES_PASSWORD=
POSTGRES_DB=orchestrator

# Optional shared bearer token for /v1 routes (leave empty to disable). Not RBAC.
CFO_API_TOKEN=

# Seconds a worker owns a claimed job between heartbeats.
CFO_LEASE_SECONDS=300
