{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kozphy/ci-failure-orchestrator/benchmark/research_case.schema.json",
  "title": "CI Failure Research Case",
  "description": "Schema 1.1. Compatible with 1.0 cases: every 1.0 field keeps its meaning and every new field is optional. Diagnosis inputs (observed_failures, failure_time_context, pipeline) must contain only information available when the failure happened; ground_truth and provenance.fix_commit are for scoring only.",
  "type": "object",
  "required": [
    "case_id",
    "source_type",
    "repository",
    "commit_sha",
    "failure_category",
    "observed_failures",
    "ground_truth",
    "verification",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "1.1"]},
    "case_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source_type": {
      "type": "string",
      "enum": ["synthetic", "fixture", "public_real_world", "private_real_world"]
    },
    "split": {"type": "string", "enum": ["train", "dev", "development", "test", "holdout"]},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["diagnosis", "repair"]}
    },
    "repository": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "minLength": 7},
    "workflow": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "integer", "null"]},
    "failed_job": {"type": ["string", "null"]},
    "failed_step": {"type": ["string", "null"]},
    "failure_category": {
      "type": "string",
      "enum": [
        "dependency",
        "compilation_or_syntax",
        "lint_or_formatting",
        "unit_test",
        "integration_test",
        "configuration",
        "security_or_policy",
        "flaky_or_nondeterministic",
        "timeout_or_resource",
        "infrastructure_or_environment",
        "cross_job_dependency",
        "other"
      ]
    },
    "observed_failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "error_type"],
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "error_type": {"type": "string", "minLength": 1},
          "log_excerpt": {"type": ["string", "null"]},
          "evidence_digest": {"type": ["string", "null"]},
          "order": {"type": "integer"},
          "confidence": {"type": "number"},
          "severity": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["stages"],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "depends_on": {"type": "array", "items": {"type": "string"}},
              "criticality": {"type": "number"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "failure_time_context": {
      "type": "object",
      "properties": {
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "workflow_excerpt": {"type": ["string", "null"]},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "excerpt"],
            "properties": {
              "path": {"type": "string"},
              "excerpt": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ground_truth": {
      "type": "object",
      "required": ["root_cause", "validation_method"],
      "properties": {
        "root_cause": {"type": "string", "minLength": 1},
        "validation_method": {
          "type": "string",
          "enum": ["known_fixture", "maintainer_confirmed", "patch_verified", "independent_review", "other"]
        },
        "root_cause_stage": {"type": ["string", "null"]},
        "expected_repair": {"type": ["string", "null"]},
        "repair_constraints": {"type": "array", "items": {"type": "string"}},
        "annotator": {"type": ["string", "null"]},
        "annotated_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["required_checks"],
      "properties": {
        "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "targeted_tests": {"type": "array", "items": {"type": "string"}},
        "full_regression_required": {"type": "boolean", "default": true},
        "security_gate_required": {"type": "boolean", "default": true},
        "policy_gate_required": {"type": "boolean", "default": true},
        "real_ci_required": {"type": "boolean", "default": true},
        "waived_gates": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_uri", "license_or_permission", "captured_at"],
      "properties": {
        "source_uri": {"type": "string", "minLength": 1},
        "license_or_permission": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "collector": {"type": ["string", "null"]},
        "content_digest": {"type": ["string", "null"]},
        "derived_from": {"type": ["string", "null"]},
        "fix_commit": {"type": ["string", "null"]},
        "failure_time_cutoff": {"type": ["string", "null"], "format": "date-time"},
        "author_controlled": {"type": "boolean"},
        "annotation_status": {
          "type": "string",
          "enum": ["labelled", "unlabelled", "disputed"]
        }
      },
      "additionalProperties": false
    },
    "repair_fixture": {
      "type": "object",
      "required": ["files", "ci_command", "candidates", "hidden_oracle"],
      "properties": {
        "files": {"type": "object", "additionalProperties": {"type": "string"}},
        "ci_command": {"type": "string", "minLength": 1},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["candidate_id", "label", "edits"],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "label": {
                "type": "string",
                "enum": ["correct", "fake_fix", "semantically_wrong", "regression", "no_op"]
              },
              "fake_fix_kind": {"type": ["string", "null"]},
              "description": {"type": "string"},
              "edits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["op", "path"],
                  "properties": {
                    "op": {"type": "string", "enum": ["replace_text", "write", "delete"]},
                    "path": {"type": "string", "minLength": 1},
                    "old": {"type": "string"},
                    "new": {"type": "string"},
                    "content": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "hidden_oracle": {
          "type": "object",
          "required": ["files", "command"],
          "properties": {
            "files": {"type": "object", "additionalProperties": {"type": "string"}},
            "command": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
