# Configure only providers installed on the runner.
# Each value is parsed as argv; prompts are sent through stdin, never appended to argv.
# Keep credentials in the runner secret store, not in this file.

CI_ORCHESTRATOR_CURSOR_CMD="cursor-agent"
CI_ORCHESTRATOR_CLAUDE_CMD="claude"
CI_ORCHESTRATOR_CODEX_CMD="codex"
CI_ORCHESTRATOR_GEMINI_CMD="gemini"
